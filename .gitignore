# --- Pebble watchface (watchface/) ---
# Build output is fully regenerated by `pebble build`; never commit it.
watchface/build/
watchface/.lock-waf_linux_build
*.pbw

# --- Android companion (android/) ---
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/captures/
android/.cxx/
*.apk
*.aab
*.keystore
*.jks

# --- Node / PebbleKit JS tooling ---
node_modules/
npm-debug.log*

# --- Editor / OS cruft ---
.idea/
*.iml
.DS_Store
Thumbs.db
