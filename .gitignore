# ---------------------------------------------------------------------------
# proto monorepo
# ---------------------------------------------------------------------------

# --- Pebble watchface (watchface/) ---
# Build output is fully regenerated by `pebble build`; never commit it.
watchface/build/
watchface/.lock-waf_linux_build
*.pbw

# --- Android companion (pipe/) ---
# The module also carries its own Android Studio .gitignore; these are the
# repo-level backstop so artifacts stay out even if that file is regenerated.
pipe/build/
pipe/app/build/
pipe/.gradle/
pipe/.kotlin/
pipe/local.properties
pipe/captures/
pipe/.cxx/
*.apk
*.aab
*.keystore
*.jks

# --- Node / PebbleKit JS tooling ---
node_modules/
npm-debug.log*

# --- Editor / OS cruft ---
.idea/
*.iml
.DS_Store
Thumbs.db
