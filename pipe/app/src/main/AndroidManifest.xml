<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The calendar is the app's only data source. Runtime-requested by
         MainActivity; CalendarSource re-checks before every query, because the grant
         can be revoked while the service is running. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- PipeService is the app's process keeper. Nothing else holds it open now that
         the notification shade is no longer read, and calendar observation, the
         phone's battery level and the liveness heartbeat all have to outlive the
         activity. DATA_SYNC is the type that fits: keeping a remote device's copy of
         local data current. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- For the foreground service's own ongoing notification (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Nothing rebinds a foreground service after a reboot, so we restart it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility (Android 11+). PebbleKit talks to the Pebble app by
         broadcast and reads its content provider to answer isWatchConnected();
         both are invisible without an explicit <queries> declaration. -->
    <queries>
        <package android:name="com.getpebble.android.basalt" />
        <package android:name="com.getpebble.android" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProtoPipe">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ProtoPipe"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: started only by MainActivity and BootReceiver. -->
        <service
            android:name=".PipeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
